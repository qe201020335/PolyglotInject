{
  "$schema": "https://raw.githubusercontent.com/QuestPackageManager/QPM.Package/refs/heads/main/qpm.schema.json",
  "version": "0.8.0",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "PolyglotInject",
    "id": "PolyglotInject",
    "version": "0.8.0",
    "url": "https://github.com/qe201020335/PolyglotInject",
    "additionalData": {
      "overrideSoName": "libPolyglotInject.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "python ./extern/includes/mod-scripts/shared/build.py $0:?"
      ],
      "copy": [
        "python ./extern/includes/mod-scripts/shared/cpy.py $0:?"
      ],
      "debug": [
        "python ./extern/includes/mod-scripts/shared/debug.py $0:?"
      ],
      "log": [
        "python ./extern/includes/mod-scripts/shared/log.py $0:?"
      ],
      "profile": [
        "python ./extern/includes/mod-scripts/shared/profile.py $0:?"
      ],
      "qmod": [
        "pwsh ./scripts/qmod.ps1 $0:?"
      ],
      "restart": [
        "python ./extern/includes/mod-scripts/shared/restart.py $0:?"
      ]
    },
    "ndk": "^28.2.13676358",
    "qmodIncludeDirs": [
      "./build",
      "./extern/libs",
      "./fonts",
      "."
    ],
    "qmodIncludeFiles": [],
    "qmodOutput": "./PolyglotInject.qmod"
  },
  "dependencies": [
    {
      "id": "mod-scripts",
      "versionRange": "^1.0.2",
      "additionalData": {}
    },
    {
      "id": "scotland2",
      "versionRange": "^0.1.7",
      "additionalData": {
        "includeQmod": false
      }
    },
    {
      "id": "paper2_scotland2",
      "versionRange": "^4.8.0",
      "additionalData": {}
    },
    {
      "id": "beatsaber-hook",
      "versionRange": "^6.4.2",
      "additionalData": {}
    },
    {
      "id": "bs-cordl",
      "versionRange": "^4008.0.0",
      "additionalData": {}
    },
    {
      "id": "metacore",
      "versionRange": "^1.6.3",
      "additionalData": {}
    }
  ]
}
